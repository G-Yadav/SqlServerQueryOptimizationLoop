<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.15.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0-preview.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored STATISTICS IO/TIME parser (open source), run in-process via Jint.
         Remove from the default None glob first so it embeds deterministically.
         The English lang config it needs is compiled in via LangEn.cs. -->
    <None Remove="Infrastructure/Resources/StatsParser/parser.js" />
    <EmbeddedResource Include="Infrastructure/Resources/StatsParser/parser.js" LogicalName="StatsParser.parser.js" />
  </ItemGroup>

</Project>
